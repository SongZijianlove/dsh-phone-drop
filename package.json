{
  "name": "dsh-phone-drop",
  "version": "0.4.3",
  "description": "局域网手机直传：电脑屏幕上出个二维码，手机扫一下就打开；拍照或扫描成黑白文档，直接落进电脑文件夹，不经过任何隧道，毫秒级。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-phone-drop": "lib/cli.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./setup": "./lib/setup.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "phone",
    "scan",
    "scanner",
    "upload",
    "lan",
    "camera",
    "qr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SongZijianlove/dsh-phone-drop.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "postinstall": "node lib/postinstall.js"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
